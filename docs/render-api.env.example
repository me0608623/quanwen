# Render API production env example
NODE_ENV=production
PORT=10000
DATABASE_URL=postgresql://<user>:<password>@<host>:5432/quanwen
REDIS_URL=redis://default:<password>@<host>:6379
WEB_URL=https://<your-vercel-domain>
# 若要同時放 custom domain + vercel 預設 domain，可逗號分隔：
# WEB_URL=https://quanwen.tw,https://quanwen.vercel.app
API_URL=https://<your-render-api-domain>
JWT_SECRET=<generate-with-openssl-rand-base64-48>
PII_ENCRYPTION_KEY=<generate-with-openssl-rand-hex-32>
PII_KDF_SALT=<generate-with-openssl-rand-hex-16>
ENABLE_SWAGGER=0

# Optional but recommended
ZAI_API_KEY=
ZAI_BASE_URL=https://api.z.ai/api/paas/v4
ZAI_MODEL=glm-5.1
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
MAIL_FROM=QuanWen <noreply@quanwen.tw>
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# OAuth callbacks
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=https://<your-render-api-domain>/api/v1/auth/google/callback
LINE_CHANNEL_ID=
LINE_CHANNEL_SECRET=
LINE_CALLBACK_URL=https://<your-render-api-domain>/api/v1/auth/line/callback
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----
APPLE_CALLBACK_URL=https://<your-render-api-domain>/api/v1/auth/apple/callback

# ECPay production
ECPAY_MERCHANT_ID=
ECPAY_HASH_KEY=
ECPAY_HASH_IV=
ECPAY_PAYMENT_URL=https://payment.ecpay.com.tw/Cashier/AioCheckOut/V5
