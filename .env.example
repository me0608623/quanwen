# ─── Database ─────────────────────────────────────────────────
DATABASE_URL=postgresql://quanwen:quanwen@localhost:5432/quanwen_dev

# ─── Redis (BullMQ) ───────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── JWT ──────────────────────────────────────────────────────
JWT_SECRET=change_me_to_a_64_char_random_string
JWT_EXPIRES_IN=7d

# ─── Google OAuth ─────────────────────────────────────────────
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:3001/auth/google/callback

# ─── Z.ai LLM (AI 審核) ───────────────────────────────────────
ZAI_API_KEY=your_zai_api_key
ZAI_BASE_URL=https://api.z.ai/api/paas/v4
ZAI_MODEL=glm-5.1

# ─── ECPay 綠界 ───────────────────────────────────────────────
ECPAY_MERCHANT_ID=your_ecpay_merchant_id
ECPAY_HASH_KEY=your_ecpay_hash_key
ECPAY_HASH_IV=your_ecpay_hash_iv
ECPAY_PAYMENT_URL=https://payment-stage.ecpay.com.tw/Cashier/AioCheckOut/V5

# ─── App URLs ─────────────────────────────────────────────────
API_URL=http://localhost:3001
WEB_URL=http://localhost:3000
NODE_ENV=development

# ─── Sentry (Observability) ───────────────────────────────────
SENTRY_DSN=your_sentry_dsn
