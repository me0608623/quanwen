# ─── Database ─────────────────────────────────────────────────
DATABASE_URL=postgresql://quanwen:quanwen@localhost:5432/quanwen_dev

# ─── Redis (BullMQ) ───────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── JWT ──────────────────────────────────────────────────────
JWT_SECRET=change_me_to_a_64_char_random_string
JWT_EXPIRES_IN=7d

# ─── Google OAuth ─────────────────────────────────────────────
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:3001/api/v1/auth/google/callback

# ─── LINE OAuth ────────────────────────────────────────────────
# LINE Developers console: https://developers.line.biz/
LINE_CHANNEL_ID=your_line_channel_id
LINE_CHANNEL_SECRET=your_line_channel_secret
LINE_CALLBACK_URL=http://localhost:3001/api/v1/auth/line/callback

# ─── Apple Sign In ─────────────────────────────────────────────
# Apple Developer: https://developer.apple.com/account/resources/identifiers/
APPLE_CLIENT_ID=your.app.bundle.id          # Services ID (NOT App ID)
APPLE_TEAM_ID=YOUR_TEAM_ID                  # 10-character Team ID
APPLE_KEY_ID=YOUR_KEY_ID                    # 10-character key ID
# Paste the .p8 private key content (with header/footer, \n for newlines):
APPLE_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\nMIGTAgEA...\n-----END PRIVATE KEY-----
APPLE_CALLBACK_URL=http://localhost:3001/api/v1/auth/apple/callback

# ─── Z.ai LLM (AI 審核) ───────────────────────────────────────
ZAI_API_KEY=your_zai_api_key
ZAI_BASE_URL=https://api.z.ai/api/paas/v4
ZAI_MODEL=glm-5.1

# ─── ECPay 綠界 ───────────────────────────────────────────────
ECPAY_MERCHANT_ID=your_ecpay_merchant_id
ECPAY_HASH_KEY=your_ecpay_hash_key
ECPAY_HASH_IV=your_ecpay_hash_iv
ECPAY_PAYMENT_URL=https://payment-stage.ecpay.com.tw/Cashier/AioCheckOut/V5

# ─── App URLs ─────────────────────────────────────────────────
API_URL=http://localhost:3001
WEB_URL=http://localhost:3000
NODE_ENV=development
USE_PG_MEM=false  # set to true for in-memory dev (no Postgres needed)

# ─── Email (SMTP) ─────────────────────────────────────────────
# For dev: use Mailpit (http://localhost:8025) or Mailtrap
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=QuanWen <noreply@quanwen.tw>

# ─── Sentry (Observability) ───────────────────────────────────
SENTRY_DSN=your_sentry_dsn
