# ─── Database ─────────────────────────────────────────────────
DATABASE_URL=postgresql://quanwen:quanwen@localhost:5432/quanwen_dev

# ─── Redis (BullMQ) ───────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── JWT ──────────────────────────────────────────────────────
JWT_SECRET=change_me_to_a_64_char_random_string
JWT_EXPIRES_IN=7d

# ─── PII 加密（Phase B / K.3）──────────────────────────────────
# prod 必設！遺失即無法解密 KYC 身分證 / 銀行帳號等加密資料
# 任意長度隨機字串，建議 32+ chars
PII_ENCRYPTION_KEY=change_me_to_a_random_32_char_string
# scrypt KDF salt（強烈建議：openssl rand -hex 16）
PII_KDF_SALT=change_me_to_a_random_16_byte_hex

# ─── Google OAuth ─────────────────────────────────────────────
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:3001/api/v1/auth/google/callback

# ─── LINE OAuth ────────────────────────────────────────────────
# LINE Developers console: https://developers.line.biz/
LINE_CHANNEL_ID=your_line_channel_id
LINE_CHANNEL_SECRET=your_line_channel_secret
LINE_CALLBACK_URL=http://localhost:3001/api/v1/auth/line/callback

# ─── Apple Sign In ─────────────────────────────────────────────
# Apple Developer: https://developer.apple.com/account/resources/identifiers/
APPLE_CLIENT_ID=your.app.bundle.id          # Services ID (NOT App ID)
APPLE_TEAM_ID=YOUR_TEAM_ID                  # 10-character Team ID
APPLE_KEY_ID=YOUR_KEY_ID                    # 10-character key ID
# Paste the .p8 private key content (with header/footer, \n for newlines):
APPLE_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\nMIGTAgEA...\n-----END PRIVATE KEY-----
APPLE_CALLBACK_URL=http://localhost:3001/api/v1/auth/apple/callback

# ─── Z.ai LLM (AI 審核) ───────────────────────────────────────
ZAI_API_KEY=your_zai_api_key
ZAI_BASE_URL=https://api.z.ai/api/paas/v4
ZAI_MODEL=glm-5.1

# ─── ECPay 綠界 ───────────────────────────────────────────────
ECPAY_MERCHANT_ID=your_ecpay_merchant_id
ECPAY_HASH_KEY=your_ecpay_hash_key
ECPAY_HASH_IV=your_ecpay_hash_iv
ECPAY_PAYMENT_URL=https://payment-stage.ecpay.com.tw/Cashier/AioCheckOut/V5

# ─── App URLs ─────────────────────────────────────────────────
API_URL=http://localhost:3001
# 可填單一 origin，或多個 origin（逗號 / 空白分隔）
# 例：WEB_URL=https://quanwen.vercel.app,https://quanwen-prod.vercel.app
WEB_URL=http://localhost:3000
NODE_ENV=development
USE_PG_MEM=false  # set to true for in-memory dev (no Postgres needed)

# ─── Email (SMTP) ─────────────────────────────────────────────
# For dev: use Mailpit (http://localhost:8025) or Mailtrap
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=QuanWen <noreply@quanwen.tw>

# ─── Sentry (Observability) ───────────────────────────────────
# 後端 (apps/api)
SENTRY_DSN=your_sentry_dsn
SENTRY_TRACES_SAMPLE_RATE=0.1
# 前端 (apps/web) — Next.js 需要 NEXT_PUBLIC_ prefix 才會 expose 到 browser
NEXT_PUBLIC_SENTRY_DSN=your_sentry_dsn
NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1

# ─── Langfuse (LLM Observability) ────────────────────────────
# Phase II.LF (QUA-175): 設定後自動啟用 LLM call tracing
# 未設定 → Langfuse sink 自動 no-op，不影響主流程
# 註冊 https://cloud.langfuse.com 取得免費方案 keys
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# 自架時改為 self-hosted URL（Phase B），預設用雲端
LANGFUSE_HOST=https://cloud.langfuse.com

# ─── Swagger（dev 用，prod 不要開）────────────────────────────
ENABLE_SWAGGER=0

# ─── 積分商城禮券發放（point-shop voucher issuer）──────────────
# demo（預設）= 產生隨機 PIN（雛形/測試，不串外部）；http = 打真實禮券供應商 REST API
VOUCHER_PROVIDER=demo
# http 模式必填：供應商發券端點與金鑰（向 Edenred 好禮即享券 for business / GiftPay / ibon 企業採購等簽約取得）
VOUCHER_API_URL=
VOUCHER_API_KEY=
# 可選：組 SKU 前綴（最終 sku = <prefix><category>_<faceValue>，預設無前綴）
VOUCHER_SKU_PREFIX=
