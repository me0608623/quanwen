# NestJS API base URL including /api/v1 prefix (matches apps/web NEXT_PUBLIC_API_URL)
# Android emulator → host machine: http://10.0.2.2:3001/api/v1
# Physical device on same LAN → http://<your-lan-ip>:3001/api/v1
# Production example: https://quanwen-api.onrender.com/api/v1
EXPO_PUBLIC_API_URL=http://10.0.2.2:3001/api/v1
