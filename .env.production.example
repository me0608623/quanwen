# QuanWen production env example
# 用於 Vercel + Render 免費部署；私密值請填真實 secrets，不要 commit .env.production

# ─── API / Render ──────────────────────────────────────────────
NODE_ENV=production
PORT=10000
DATABASE_URL=postgresql://<user>:<password>@<host>:5432/quanwen
REDIS_URL=redis://default:<password>@<host>:6379
WEB_URL=https://your-vercel-app.vercel.app
CORS_ORIGINS=https://your-vercel-app.vercel.app,https://your-custom-domain.com
API_URL=https://your-render-api.onrender.com
JWT_SECRET=replace-with-at-least-64-random-characters
PII_ENCRYPTION_KEY=replace-with-at-least-64-random-characters
PII_KDF_SALT=replace-with-random-16-byte-hex
ENABLE_SWAGGER=0

# Optional but recommended
ZAI_API_KEY=
ZAI_BASE_URL=https://api.z.ai/api/paas/v4
ZAI_MODEL=glm-5.1
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
MAIL_FROM=QuanWen <noreply@quanwen.tw>
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# OAuth callbacks
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=https://your-render-api.onrender.com/api/v1/auth/google/callback
LINE_CHANNEL_ID=
LINE_CHANNEL_SECRET=
LINE_CALLBACK_URL=https://your-render-api.onrender.com/api/v1/auth/line/callback
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----
APPLE_CALLBACK_URL=https://your-render-api.onrender.com/api/v1/auth/apple/callback

# ECPay production
ECPAY_MERCHANT_ID=
ECPAY_HASH_KEY=
ECPAY_HASH_IV=
ECPAY_PAYMENT_URL=https://payment.ecpay.com.tw/Cashier/AioCheckOut/V5

# ─── Web / Vercel ──────────────────────────────────────────────
NEXT_PUBLIC_API_URL=https://your-render-api.onrender.com/api/v1
NEXT_PUBLIC_SENTRY_DSN=
